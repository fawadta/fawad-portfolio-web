{
  "name": "Faq",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The question as it appears on the About page."
    },
    "description": {
      "type": "string",
      "description": "The answer, written as plain, quotable prose."
    },
    "topic": {
      "type": "string",
      "description": "Short label grouping the question, e.g. Availability."
    },
    "sort_order": {
      "type": "number",
      "description": "Display order on the About page."
    }
  },
  "required": [
    "question",
    "description"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}